# PostgreSQL connection string from your database provider
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Generate a long random secret; never commit a real secret
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Initial admin account, created on first server start if it does not exist
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Comma-separated origins allowed to call the API
CLIENT_ORIGINS=http://localhost:5173,https://demo-construct.netlify.app
PORT=4000
